#!/usr/bin/env python3
"""Fake `claude` executable for tests (ADR-0013).

Behavior is driven by a JSON scenario file (env FAKE_CLAUDE_SCENARIO) keyed by mode:

    version      {"stdout": "...", "exit": 0}
    agents       {"sessions": [...], "exit": 0}              -> `claude agents --json`
    auth_status  {"json": {...}, "exit": 0}                  -> `claude auth status [--json]`
    auth_login   {"stdout": "...", "exit": 0, "delay": 0}    -> `claude auth login`
    stream       {"get_usage": {...}, "delay": 0, "registry": false, "ignore_sigterm": false}
                                                             -> `claude -p --input-format stream-json …`
                 get_usage handler, either legacy {"response": {...}} | {"error": "..."} or
                 {"mode": ok|logged_out|malformed|slow|no_response|exit_early,
                  "payload": {...} (ok/slow; default: fixtures/get_usage/ok_max.json),
                  "delay_s": 0 (slow), "exit_on_eof": false (no_response)}
                 Emits `system/hook_started` lines unless `--settings` disables all hooks.
                 "registry": true writes <CLAUDE_CONFIG_DIR>/sessions/<pid>.json + <pid>.fake.key,
                 removed again only on a graceful (stdin EOF) exit, like the real claude.
    print        {"stdout": "ok", "exit": 0, "delay": 0}     -> `claude -p <prompt>`
    interactive  {"banner": "FAKE-TUI ready"}                -> no subcommand (TUI mode)

Every mode also accepts "stderr", "exit" and "delay" (seconds, before output).
Each invocation appends one JSON line {argv, env, cwd, mode} to $FAKE_CLAUDE_LOG.
Unknown subcommands exit 2. Later plans extend the modes.
"""

from __future__ import annotations

import json
import os
import signal
import sys
import time
from typing import Any

LOGGED_ENV_PREFIXES = ("CLAUDE", "CCS_", "AI_AGENT")


def load_scenario() -> dict[str, Any]:
    path = os.environ.get("FAKE_CLAUDE_SCENARIO")
    if not path:
        return {}
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)
    return data if isinstance(data, dict) else {}


def log_call(argv: list[str], mode: str) -> None:
    path = os.environ.get("FAKE_CLAUDE_LOG")
    if not path:
        return
    env = {k: v for k, v in os.environ.items() if k.startswith(LOGGED_ENV_PREFIXES)}
    line = json.dumps({"argv": argv, "env": env, "cwd": os.getcwd(), "mode": mode})
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(line + "\n")


def detect_mode(argv: list[str]) -> str:
    if "--version" in argv or "-v" in argv:
        return "version"
    if argv[:1] == ["agents"]:
        return "agents"
    if argv[:2] == ["auth", "status"]:
        return "auth_status"
    if argv[:2] == ["auth", "login"]:
        return "auth_login"
    if argv[:1] == ["auth"]:
        return "unknown"
    if "-p" in argv or "--print" in argv:
        if "stream-json" in argv:
            return "stream"
        return "print"
    if argv and not argv[0].startswith("-"):
        # a positional word that is not a known subcommand is a prompt only when flags came first;
        # bare unknown words are treated as unknown subcommands.
        return "unknown"
    return "interactive"


def finish(spec: dict[str, Any], default_stdout: str = "") -> int:
    delay = float(spec.get("delay", 0))
    if delay:
        time.sleep(delay)
    out = spec.get("stdout", default_stdout)
    if out:
        sys.stdout.write(out if out.endswith("\n") else out + "\n")
        sys.stdout.flush()
    err = spec.get("stderr")
    if err:
        sys.stderr.write(err if err.endswith("\n") else err + "\n")
        sys.stderr.flush()
    return int(spec.get("exit", 0))


FIXTURES = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "fixtures", "get_usage")


def fixture_payload(name: str) -> dict[str, Any]:
    with open(os.path.join(FIXTURES, name), encoding="utf-8") as fh:
        data = json.load(fh)
    payload = data.get("response", {}).get("response", {})
    return payload if isinstance(payload, dict) else {}


def hooks_disabled(argv: list[str]) -> bool:
    for i, arg in enumerate(argv):
        if arg == "--settings" and i + 1 < len(argv):
            try:
                settings = json.loads(argv[i + 1])
            except json.JSONDecodeError:
                continue
            if isinstance(settings, dict) and settings.get("disableAllHooks") is True:
                return True
    return False


def emit(obj: dict[str, Any]) -> None:
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def registry_paths() -> list[str]:
    base = os.environ.get("CLAUDE_CONFIG_DIR")
    if not base:
        return []
    sessions = os.path.join(base, "sessions")
    pid = os.getpid()
    return [os.path.join(sessions, f"{pid}.json"), os.path.join(sessions, f"{pid}.fake.key")]


def write_registry() -> None:
    paths = registry_paths()
    if not paths:
        return
    os.makedirs(os.path.dirname(paths[0]), exist_ok=True)
    for path in paths:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(json.dumps({"pid": os.getpid(), "kind": "interactive"}))


def remove_registry() -> None:
    for path in registry_paths():
        try:
            os.remove(path)
        except FileNotFoundError:
            pass


def hang_forever() -> None:
    while True:
        time.sleep(3600)


def usage_response(handler: dict[str, Any], request_id: Any) -> dict[str, Any] | None:
    """The control_response body for a get_usage handler (None = never answer)."""
    mode = handler.get("mode")
    if mode is None:  # legacy handler shape
        if "error" in handler:
            return {"subtype": "error", "request_id": request_id, "error": handler["error"]}
        return {"subtype": "success", "request_id": request_id, "response": handler.get("response", {})}
    if mode == "no_response":
        return None
    if mode == "slow":
        time.sleep(float(handler.get("delay_s", 0)))
    if mode in ("ok", "slow"):
        payload = handler.get("payload")
        if not isinstance(payload, dict):
            payload = fixture_payload("ok_max.json")
    elif mode == "logged_out":
        payload = fixture_payload("logged_out.json")
    elif mode == "malformed":
        payload = {"rate_limits_available": True, "rate_limits": {"five_hour": "x"}}
    else:
        return {"subtype": "error", "request_id": request_id, "error": f"fake: bad mode {mode}"}
    return {"subtype": "success", "request_id": request_id, "response": payload}


def run_stream(spec: dict[str, Any], argv: list[str]) -> int:
    if spec.get("ignore_sigterm"):
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
    if spec.get("registry"):
        write_registry()
    if not hooks_disabled(argv):
        for _ in range(3):
            emit({"type": "system", "subtype": "hook_started"})
    usage = spec.get("get_usage", {})
    if isinstance(usage, dict) and usage.get("mode") == "exit_early":
        sys.stderr.write(usage.get("stderr", "fake: startup failure") + "\n")
        sys.stderr.flush()
        return int(usage.get("exit", 1))
    delay = float(spec.get("delay", 0))
    for raw in sys.stdin:
        raw = raw.strip()
        if not raw:
            continue
        try:
            msg = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if msg.get("type") != "control_request":
            continue
        request = msg.get("request", {})
        request_id = msg.get("request_id")
        subtype = request.get("subtype")
        handler = spec.get(subtype, {}) if isinstance(subtype, str) else {}
        if not isinstance(handler, dict):
            handler = {}
        if delay:
            time.sleep(delay)
        response = usage_response(handler, request_id)
        if response is None:
            if handler.get("exit_on_eof"):
                continue
            hang_forever()
        emit({"type": "control_response", "response": response})
    # stdin EOF: graceful exit, like the real claude (P00-S2)
    remove_registry()
    return int(spec.get("exit", 0))


def run_interactive(spec: dict[str, Any]) -> int:
    sys.stdout.write(spec.get("banner", "FAKE-TUI ready") + "\n")
    sys.stdout.flush()
    buf = b""
    fd = sys.stdin.fileno()
    while True:
        chunk = os.read(fd, 1024)
        if not chunk:
            break
        buf += chunk
        sys.stdout.write("RECV " + chunk.hex() + "\n")
        sys.stdout.flush()
        if b"/exit\r" in buf:
            break
    return int(spec.get("exit", 0))


def main() -> int:
    argv = sys.argv[1:]
    mode = detect_mode(argv)
    log_call(argv, mode)
    scenario = load_scenario()
    spec = scenario.get(mode, {})
    if not isinstance(spec, dict):
        spec = {}
    if mode == "unknown":
        sys.stderr.write(f"fake claude: unknown mode for argv {argv!r}\n")
        return 2
    if mode == "version":
        return finish(spec, "0.0.0-fake (Claude Code)")
    if mode == "agents":
        if "sessions" in spec and "stdout" not in spec:
            spec = {**spec, "stdout": json.dumps(spec["sessions"])}
        return finish(spec, "[]")
    if mode == "auth_status":
        if "json" in spec and "stdout" not in spec:
            spec = {**spec, "stdout": json.dumps(spec["json"])}
        return finish(spec, json.dumps({"loggedIn": False}))
    if mode == "auth_login":
        return finish(spec, "Login successful.")
    if mode == "stream":
        return run_stream(spec, argv)
    if mode == "print":
        return finish(spec, "ok")
    return run_interactive(spec)


if __name__ == "__main__":
    raise SystemExit(main())
