#!/usr/bin/env python3
"""Fake `claude` executable for tests (ADR-0013).

Behavior is driven by a JSON scenario file (env FAKE_CLAUDE_SCENARIO) keyed by mode:

    version      {"stdout": "...", "exit": 0}
    help         {"stdout": "...", "exit": 0, "extra_options": ["--new-flag"]}
                                                             -> `claude --help` (default: the
                 captured fixtures/claude_help/claude-2.1.281.txt; "extra_options" appends
                 option-definition lines, e.g. to simulate a new claude flag)
    agents      {"sessions": [...], "exit": 0}              -> `claude agents --json`
                 string values "$PID<n>" become the n-th pid of $FAKE_CLAUDE_AGENTS_PIDS
                 {"from_state": true} lists the running fake TUIs (their published activity)
    auth_status  {"json": {...}, "exit": 0}                  -> `claude auth status [--json]`
                 or {"stateful": true, "logged_in_json": {...}, "logged_out_json": {...}}:
                 logged in iff the auth marker exists (default JSON: fixtures/auth_status/*.json;
                 exit 0 logged in, 1 logged out, like the real claude)
    auth_login   {"stdout": "...", "exit": 0, "delay": 0, "sets_auth": false}
                                                             -> `claude auth login`
                 "sets_auth": true creates the auth marker when exit == 0
    auth_logout  {"stdout": "...", "exit": 0}                -> `claude auth logout` (removes the marker)
    stream       {"get_usage": {...}, "delay": 0, "registry": false, "ignore_sigterm": false}
                                                             -> `claude -p --input-format stream-json …`
                 get_usage handler, either legacy {"response": {...}} | {"error": "..."} or
                 {"mode": ok|logged_out|malformed|slow|no_response|exit_early|auth_marker,
                  "payload": {...} (ok/slow; default: fixtures/get_usage/ok_max.json),
                  "delay_s": 0 (slow), "exit_on_eof": false (no_response)}
                 auth_marker: ok when the auth marker exists, else logged_out
                 Emits `system/hook_started` lines unless `--settings` disables all hooks.
                 "registry": true writes <CLAUDE_CONFIG_DIR>/sessions/<pid>.json + <pid>.fake.key,
                 removed again only on a graceful (stdin EOF) exit, like the real claude.
    print        {"stdout": "ok", "exit": 0, "delay": 0}     -> `claude -p <prompt>`
                 "activate_window_s": N  (exit 0 only) -> later `get_usage` ok/slow payloads
                 show an active 5h window resetting N s from now ("activate_percent", default 1).
                 State lives in $FAKE_CLAUDE_STATE (default: <scenario>.state.json).
    interactive  {"banner": "FAKE-TUI ready", "exit": 0, "status": "idle",
                  "after_esc": "idle", "after_submit": null, "stop_on": null, "echo": true}
                                                             -> no subcommand (TUI mode)
                 Raw mode on its tty; every read chunk is logged as {"recv": <hex>} to
                 $FAKE_CLAUDE_TUI_LOG (default "$FAKE_CLAUDE_LOG.tui"), SIGWINCH as {"winsize": [r, c]}.
                 Ctrl-D (0x04) or "/exit\r" exits with "exit". A lone ESC sets the activity to
                 "after_esc", a submit (\r) to "after_submit" (if set). "stop_on": "\u001a" makes it
                 SIGTSTP itself when that byte arrives. The activity is published in
                 $FAKE_CLAUDE_STATE_DIR/<pid>.json (default "$FAKE_CLAUDE_LOG.state/") for
                 `agents` with {"from_state": true}.

Every mode also accepts "stderr", "exit" and "delay" (seconds, before output).
The auth marker is `<CLAUDE_CONFIG_DIR>/.fake-auth` (per profile, never a real config dir in tests).
Each invocation appends one JSON line {argv, env, cwd, mode} to $FAKE_CLAUDE_LOG.
Unknown subcommands exit 2. Later plans extend the modes.
"""

from __future__ import annotations

import copy
import json
import os
import signal
import sys
import time
from typing import Any

LOGGED_ENV_PREFIXES = ("CLAUDE", "CCS_", "AI_AGENT")


def load_scenario() -> dict[str, Any]:
    path = os.environ.get("FAKE_CLAUDE_SCENARIO")
    if not path:
        return {}
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)
    return data if isinstance(data, dict) else {}


def log_call(argv: list[str], mode: str) -> None:
    path = os.environ.get("FAKE_CLAUDE_LOG")
    if not path:
        return
    env = {k: v for k, v in os.environ.items() if k.startswith(LOGGED_ENV_PREFIXES)}
    line = json.dumps({"argv": argv, "env": env, "cwd": os.getcwd(), "mode": mode})
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(line + "\n")


def detect_mode(argv: list[str]) -> str:
    if argv[:1] in (["--help"], ["-h"]):
        return "help"
    if "--version" in argv or "-v" in argv:
        return "version"
    if argv[:1] == ["agents"]:
        return "agents"
    if argv[:2] == ["auth", "status"]:
        return "auth_status"
    if argv[:2] == ["auth", "login"]:
        return "auth_login"
    if argv[:2] == ["auth", "logout"]:
        return "auth_logout"
    if argv[:1] == ["auth"]:
        return "unknown"
    if "-p" in argv or "--print" in argv:
        if "stream-json" in argv:
            return "stream"
        return "print"
    if argv and not argv[0].startswith("-"):
        # a positional word that is not a known subcommand is a prompt only when flags came first;
        # bare unknown words are treated as unknown subcommands.
        return "unknown"
    return "interactive"


def finish(spec: dict[str, Any], default_stdout: str = "") -> int:
    delay = float(spec.get("delay", 0))
    if delay:
        time.sleep(delay)
    out = spec.get("stdout", default_stdout)
    if out:
        sys.stdout.write(out if out.endswith("\n") else out + "\n")
        sys.stdout.flush()
    err = spec.get("stderr")
    if err:
        sys.stderr.write(err if err.endswith("\n") else err + "\n")
        sys.stderr.flush()
    return int(spec.get("exit", 0))


FIXTURES = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "fixtures", "get_usage")
AUTH_FIXTURES = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "fixtures", "auth_status")
HELP_FIXTURE = os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "fixtures", "claude_help", "claude-2.1.281.txt"
)


def help_text(spec: dict[str, Any]) -> str:
    if "stdout" in spec:
        return str(spec["stdout"])
    with open(HELP_FIXTURE, encoding="utf-8") as fh:
        text = fh.read()
    extra = spec.get("extra_options") or []
    lines = [f"  {opt}                           fake option added by the test" for opt in extra]
    return text + ("\n".join(lines) + "\n" if lines else "")


def auth_marker() -> str | None:
    base = os.environ.get("CLAUDE_CONFIG_DIR")
    return os.path.join(base, ".fake-auth") if base else None


def marker_exists() -> bool:
    marker = auth_marker()
    return bool(marker) and os.path.exists(marker)


def set_marker(present: bool) -> None:
    marker = auth_marker()
    if not marker:
        return
    if present:
        os.makedirs(os.path.dirname(marker), exist_ok=True)
        with open(marker, "w", encoding="utf-8") as fh:
            fh.write("fake\n")
    else:
        try:
            os.remove(marker)
        except FileNotFoundError:
            pass


def auth_fixture(name: str) -> dict[str, Any]:
    with open(os.path.join(AUTH_FIXTURES, name), encoding="utf-8") as fh:
        data = json.load(fh)
    return data if isinstance(data, dict) else {}


def fixture_payload(name: str) -> dict[str, Any]:
    with open(os.path.join(FIXTURES, name), encoding="utf-8") as fh:
        data = json.load(fh)
    payload = data.get("response", {}).get("response", {})
    return payload if isinstance(payload, dict) else {}


def hooks_disabled(argv: list[str]) -> bool:
    for i, arg in enumerate(argv):
        if arg == "--settings" and i + 1 < len(argv):
            try:
                settings = json.loads(argv[i + 1])
            except json.JSONDecodeError:
                continue
            if isinstance(settings, dict) and settings.get("disableAllHooks") is True:
                return True
    return False


def emit(obj: dict[str, Any]) -> None:
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def registry_paths() -> list[str]:
    base = os.environ.get("CLAUDE_CONFIG_DIR")
    if not base:
        return []
    sessions = os.path.join(base, "sessions")
    pid = os.getpid()
    return [os.path.join(sessions, f"{pid}.json"), os.path.join(sessions, f"{pid}.fake.key")]


def write_registry() -> None:
    paths = registry_paths()
    if not paths:
        return
    os.makedirs(os.path.dirname(paths[0]), exist_ok=True)
    for path in paths:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(json.dumps({"pid": os.getpid(), "kind": "interactive"}))


def remove_registry() -> None:
    for path in registry_paths():
        try:
            os.remove(path)
        except FileNotFoundError:
            pass


def state_path() -> str | None:
    explicit = os.environ.get("FAKE_CLAUDE_STATE")
    if explicit:
        return explicit
    scenario = os.environ.get("FAKE_CLAUDE_SCENARIO")
    return f"{scenario}.state.json" if scenario else None


def load_state() -> dict[str, Any]:
    path = state_path()
    if not path or not os.path.exists(path):
        return {}
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, json.JSONDecodeError):
        return {}
    return data if isinstance(data, dict) else {}


def save_state(state: dict[str, Any]) -> None:
    path = state_path()
    if not path:
        return
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(state, fh)


def apply_state(payload: dict[str, Any]) -> dict[str, Any]:
    """Overlay the session window a warm-up (`print.activate_window_s`) started."""
    session = load_state().get("session")
    limits = payload.get("rate_limits")
    if not isinstance(session, dict) or not isinstance(limits, dict):
        return payload
    payload = copy.deepcopy(payload)
    resets = time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime(session["resets_at_epoch"]))
    payload["rate_limits"]["five_hour"] = {
        "utilization": session.get("percent", 1),
        "resets_at": resets,
    }
    return payload


def run_print(spec: dict[str, Any]) -> int:
    code = finish(spec, "ok")
    seconds = spec.get("activate_window_s")
    if code == 0 and isinstance(seconds, (int, float)):
        state = load_state()
        state["session"] = {
            "resets_at_epoch": time.time() + float(seconds),
            "percent": spec.get("activate_percent", 1),
        }
        save_state(state)
    return code


def hang_forever() -> None:
    while True:
        time.sleep(3600)


def usage_response(handler: dict[str, Any], request_id: Any) -> dict[str, Any] | None:
    """The control_response body for a get_usage handler (None = never answer)."""
    mode = handler.get("mode")
    if mode is None:  # legacy handler shape
        if "error" in handler:
            return {"subtype": "error", "request_id": request_id, "error": handler["error"]}
        return {"subtype": "success", "request_id": request_id, "response": handler.get("response", {})}
    if mode == "no_response":
        return None
    if mode == "slow":
        time.sleep(float(handler.get("delay_s", 0)))
    if mode in ("ok", "slow"):
        payload = handler.get("payload")
        if not isinstance(payload, dict):
            payload = fixture_payload("ok_max.json")
        payload = apply_state(payload)
    elif mode == "logged_out" or (mode == "auth_marker" and not marker_exists()):
        payload = fixture_payload("logged_out.json")
    elif mode == "auth_marker":
        payload = handler.get("payload")
        if not isinstance(payload, dict):
            payload = fixture_payload("ok_max.json")
    elif mode == "malformed":
        payload = {"rate_limits_available": True, "rate_limits": {"five_hour": "x"}}
    else:
        return {"subtype": "error", "request_id": request_id, "error": f"fake: bad mode {mode}"}
    return {"subtype": "success", "request_id": request_id, "response": payload}


def run_stream(spec: dict[str, Any], argv: list[str]) -> int:
    if spec.get("ignore_sigterm"):
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
    if spec.get("registry"):
        write_registry()
    if not hooks_disabled(argv):
        for _ in range(3):
            emit({"type": "system", "subtype": "hook_started"})
    usage = spec.get("get_usage", {})
    if isinstance(usage, dict) and usage.get("mode") == "exit_early":
        sys.stderr.write(usage.get("stderr", "fake: startup failure") + "\n")
        sys.stderr.flush()
        return int(usage.get("exit", 1))
    delay = float(spec.get("delay", 0))
    for raw in sys.stdin:
        raw = raw.strip()
        if not raw:
            continue
        try:
            msg = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if msg.get("type") != "control_request":
            continue
        request = msg.get("request", {})
        request_id = msg.get("request_id")
        subtype = request.get("subtype")
        handler = spec.get(subtype, {}) if isinstance(subtype, str) else {}
        if not isinstance(handler, dict):
            handler = {}
        if delay:
            time.sleep(delay)
        response = usage_response(handler, request_id)
        if response is None:
            if handler.get("exit_on_eof"):
                continue
            hang_forever()
        emit({"type": "control_response", "response": response})
    # stdin EOF: graceful exit, like the real claude (P00-S2)
    remove_registry()
    return int(spec.get("exit", 0))


def _derived(env_name: str, suffix: str) -> str | None:
    explicit = os.environ.get(env_name)
    if explicit:
        return explicit
    log = os.environ.get("FAKE_CLAUDE_LOG")
    return log + suffix if log else None


def tui_log(record: dict[str, Any]) -> None:
    path = _derived("FAKE_CLAUDE_TUI_LOG", ".tui")
    if not path:
        return
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(record) + "\n")


def state_dir() -> str | None:
    return _derived("FAKE_CLAUDE_STATE_DIR", ".state")


def publish_status(status: str) -> None:
    d = state_dir()
    if not d:
        return
    os.makedirs(d, exist_ok=True)
    pid = os.getpid()
    doc = {
        "pid": pid,
        "kind": "interactive",
        "status": status,
        "sessionId": f"fake-session-{pid}",
        "cwd": os.getcwd(),
    }
    tmp = os.path.join(d, f".{pid}.tmp")
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(json.dumps(doc))
    os.replace(tmp, os.path.join(d, f"{pid}.json"))


def unpublish_status() -> None:
    d = state_dir()
    if d:
        try:
            os.remove(os.path.join(d, f"{os.getpid()}.json"))
        except FileNotFoundError:
            pass


def published_sessions() -> list[dict[str, Any]]:
    d = state_dir()
    if not d or not os.path.isdir(d):
        return []
    out = []
    for name in sorted(os.listdir(d)):
        if not name.endswith(".json") or name.startswith("."):
            continue
        try:
            with open(os.path.join(d, name), encoding="utf-8") as fh:
                out.append(json.load(fh))
        except (OSError, ValueError):
            continue
    return out


def _winsize(fd: int) -> list[int]:
    import fcntl
    import struct
    import termios

    try:
        rows, cols, _, _ = struct.unpack("HHHH", fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0" * 8))
    except OSError:
        return [0, 0]
    return [rows, cols]


def run_interactive(spec: dict[str, Any], argv: list[str]) -> int:
    fd = sys.stdin.fileno()
    out = sys.stdout.fileno()
    saved = None
    if os.isatty(fd):
        import termios
        import tty

        saved = termios.tcgetattr(fd)
        tty.setraw(fd)
    status = str(spec.get("status", "idle"))
    publish_status(status)
    tui_log({"start": {"argv": argv, "isatty": saved is not None, "winsize": _winsize(fd)}})
    signal.signal(signal.SIGWINCH, lambda *_: tui_log({"winsize": _winsize(fd)}))
    os.write(out, (spec.get("banner", "FAKE-TUI ready") + "\r\nfake> ").encode())
    code = int(spec.get("exit", 0))
    buf = b""
    stop_on = spec.get("stop_on")
    try:
        while True:
            try:
                chunk = os.read(fd, 4096)
            except InterruptedError:
                continue
            except OSError:
                break
            if not chunk:
                break
            buf += chunk
            tui_log({"recv": chunk.hex()})
            if spec.get("echo", True):
                os.write(out, ("RECV " + chunk.hex() + "\r\n").encode())
            if chunk == b"\x1b":
                status = str(spec.get("after_esc", "idle"))
                publish_status(status)
            elif b"\r" in chunk and spec.get("after_submit"):
                status = str(spec["after_submit"])
                publish_status(status)
            if isinstance(stop_on, str) and stop_on.encode() in chunk:
                os.kill(os.getpid(), signal.SIGTSTP)
            if b"\x04" in chunk or b"/exit\r" in buf:
                break
    finally:
        unpublish_status()
        tui_log({"exit": code})
        if saved is not None:
            import termios

            termios.tcsetattr(fd, termios.TCSANOW, saved)
    return code


def resolve_pids(sessions: Any) -> Any:
    """Replace `"$PID<n>"` values with the n-th pid of $FAKE_CLAUDE_AGENTS_PIDS (comma list)."""
    raw = os.environ.get("FAKE_CLAUDE_AGENTS_PIDS", "")
    pids = [int(x) for x in raw.split(",") if x.strip()]

    def one(value: Any) -> Any:
        if isinstance(value, str) and value.startswith("$PID") and value[4:].isdigit():
            idx = int(value[4:])
            return pids[idx] if idx < len(pids) else None
        return value

    if not isinstance(sessions, list):
        return sessions
    return [
        {k: one(v) for k, v in item.items()} if isinstance(item, dict) else item
        for item in sessions
    ]


def main() -> int:
    argv = sys.argv[1:]
    mode = detect_mode(argv)
    log_call(argv, mode)
    scenario = load_scenario()
    spec = scenario.get(mode, {})
    if not isinstance(spec, dict):
        spec = {}
    if mode == "unknown":
        sys.stderr.write(f"fake claude: unknown mode for argv {argv!r}\n")
        return 2
    if mode == "version":
        return finish(spec, "0.0.0-fake (Claude Code)")
    if mode == "help":
        return finish({**spec, "stdout": help_text(spec)})
    if mode == "agents":
        if spec.get("from_state") and "stdout" not in spec:
            spec = {**spec, "stdout": json.dumps(published_sessions())}
        if "sessions" in spec and "stdout" not in spec:
            spec = {**spec, "stdout": json.dumps(resolve_pids(spec["sessions"]))}
        return finish(spec, "[]")
    if mode == "auth_status":
        if spec.get("stateful"):
            logged_in = marker_exists()
            key = "logged_in_json" if logged_in else "logged_out_json"
            default = auth_fixture("logged_in.json" if logged_in else "logged_out.json")
            body = spec.get(key, default)
            spec = {"stdout": json.dumps(body), "exit": 0 if logged_in else 1, **{
                k: v for k, v in spec.items() if k in ("delay", "stderr")
            }}
        elif "json" in spec and "stdout" not in spec:
            spec = {**spec, "stdout": json.dumps(spec["json"])}
        return finish(spec, json.dumps({"loggedIn": False}))
    if mode == "auth_login":
        code = finish(spec, "Login successful.")
        if code == 0 and spec.get("sets_auth"):
            set_marker(True)
        return code
    if mode == "auth_logout":
        code = finish(spec, "Successfully logged out from your Anthropic account.")
        if code == 0:
            set_marker(False)
        return code
    if mode == "stream":
        return run_stream(spec, argv)
    if mode == "print":
        return run_print(spec)
    return run_interactive(spec, argv)


if __name__ == "__main__":
    raise SystemExit(main())
